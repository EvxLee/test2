# ===== HubSpot =====
HUBSPOT_API_TOKEN=YOUR_HUBSPOT_API_TOKEN
HUBSPOT_BASE_URL=https://api.hubapi.com
HUBSPOT_PORTAL_ID=YOUR_HUBSPOT_PORTAL_ID

# ===== Database =====
# Local container DB (default for docker-compose)
ATLAS_DB_API_CONNECTION_STRING=postgresql://postgres:changeme@postgres:5432/atlasdb
# Production (managed DB) — supplied via deployment secrets
ATLAS_DB_DEPOLYMENT_CONNECTION_STRING=YOUR_PRODUCTION_CONNECTION_STRING
ATLAS_DB_API_USER=atlas-api-user
ATLAS_DB_API_PASSWORD=YOUR_DB_API_PASSWORD

# ===== API Auth =====
# Bearer token for protected ingest/display endpoints
INGEST_API_TOKEN=YOUR_INGEST_API_TOKEN

# ===== DigitalOcean Spaces (Files DB) =====
# Create a Spaces access key at: cloud.digitalocean.com → API → Spaces Keys
DO_SPACES_KEY=YOUR_DO_SPACES_ACCESS_KEY_ID
DO_SPACES_SECRET=YOUR_DO_SPACES_SECRET_KEY
DO_SPACES_BUCKET=example-atlas-storage
DO_SPACES_ENDPOINT_URL=https://sfo3.digitaloceanspaces.com
DO_SPACES_REGION_NAME=sfo3
# Legacy aliases still supported during rollout:
# DO_SPACES_ENDPOINT=sfo3.digitaloceanspaces.com
# DO_SPACES_REGION=sfo3

# ===== AWS Bedrock (Chat/LLM) =====
AWS_BEARER_TOKEN_BEDROCK=YOUR_AWS_BEARER_TOKEN_BEDROCK
AWS_REGION=us-west-1
BEDROCK_EMBEDDING_REGION=us-east-1
# Optional overrides:
# BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
# BEDROCK_OCR_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# ===== Keycloak (JWT auth) =====
# Defaults to the Atlas Keycloak instance if not set
# KEYCLOAK_JWKS_URL=https://keycloak.example.com/realms/example-realm/protocol/openid-connect/certs
