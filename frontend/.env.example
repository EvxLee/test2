# Keycloak Authentication
# Full path to Keycloak OpenID Connect endpoint
# Example: https://auth.example.com/realms/your-realm/protocol/openid-connect
VITE_KEYCLOAK_AUTH_URL=

# Keycloak client ID for this application
VITE_KEYCLOAK_CLIENT_ID=

# Frontend URL (used for OAuth redirects)
# Development: http://localhost:5173
# Production: https://your-domain.com
VITE_ATLAS_FRONTEND_URL=

# API authentication token
VITE_ATLAS_API_TOKEN=


# --- API URL is environment-specific — do NOT set VITE_ATLAS_API_URL here ---
# .env.development  -> VITE_ATLAS_API_URL=http://localhost:8081   (used by 'npm run dev')
# .env.production   -> VITE_ATLAS_API_URL=https://api.atlas-develop.example.com  (used by 'npm run build')

