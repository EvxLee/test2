-
-
-BOARD_ID = 10000000002
-
-
-def detect_stage_from_title(title: str) -> str | None:
-    """
-    Dynamically detect stage from column title.
-    This avoids hardcoding fragile Monday column IDs.
-    """
-    if not title:
-        return None
-
-    title = title.lower()
-
-    if "stage 3" in title:
-        return "stage_3"
-    elif "stage 4" in title:
-        return "stage_4"
-    elif "stage 5" in title:
-        return "stage_5"
-    elif "stage 6" in title:
-        return "stage_6"
-
-    return None
-
-
-def extract_project_startups(item: dict) -> list[dict]:
-    """
-    Extract partner startups for a single project item,
-    grouped by stage.
-    """
-    results = []
-    seen = set()
-
-    for col in item.get("column_values", []):
-        # Only care about board relation columns
-        if col.get("type") != "board_relation":
-            continue
-
-        stage = detect_stage_from_title(col.get("title"))
-
-        # Skip irrelevant columns (like Stage 6 or others)
-        if not stage:
-            continue
-
-        # Handle null safely
-        linked_items = col.get("linked_items") or []
-
-        for startup in linked_items:
-            key = (item["id"], startup["id"], stage)
-
-            # Deduplicate
-            if key in seen:
-                continue
-            seen.add(key)
-
-            results.append({
-                "project_id": item["id"],
-                "project_name": item["name"],
-                "startup_id": startup["id"],
-                "startup_name": startup["name"],
-                "stage": stage,
-
-                # Optional but VERY useful for Atlas later
-                "source": "monday",
-                "entity_type": "project_startup_relation"
-            })
-
-    return results
-
-
-def run():
-    """
-    Main pipeline:
-    - Pull data from Monday board
-    - Extract startups by stage
-    - Write normalized output
-    """
-
-    data = pull_board(BOARD_ID)
-
-    all_results = []
-
-    boards = data.get("data", {}).get("boards", [])
-    if not boards:
-        print("No boards found.")
-        return
-
-    items = boards[0].get("items_page", {}).get("items", [])
-
-    for item in items:
-        extracted = extract_project_startups(item)
-        all_results.extend(extracted)
-
-    # Optional: log if Stage 2 is missing entirely
-    if not any(r["stage"] == "stage_2" for r in all_results):
-        print("Warning: No Stage 2 startups found (column may not exist in Monday board)")
-
-    write_json("project_startups.json", all_results)
-
-    print(f"Extracted {len(all_results)} project-startup relationships")
-
-
-if __name__ == "__main__":
-    run()
